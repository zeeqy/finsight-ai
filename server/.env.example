PORT=5000
NODE_ENV=development
# Required, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173

# MySQL Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=finsight_ai

# true = the Advisor page may change the server-wide LLM key (local development only)
ALLOW_AI_SETTINGS=false

GEMINI_API_KEY=
# Optional: comma-separated Gemini models to try in order (Google retires names regularly)
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.8-flash
OPENAI_API_KEY=

# Internal Python FastAPI ML service
ML_SERVICE_URL=http://localhost:8000
