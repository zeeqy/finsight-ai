# FinSight AI - settings for the public server. Copy to .env on the server (never commit .env):
#   cp .env.production.example .env && nano .env

# Your site's address, without https:// (for example finsight-ai.duckdns.org)
DOMAIN=

# Long random secrets. Make each one with:  openssl rand -hex 32
JWT_SECRET=
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# AI advisor. Use a key from a paid (billing-enabled) Google AI Studio project for public users:
# on the free tier Google may use requests to improve its products. Without a key the advisor
# answers with the offline keyword fallback.
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
OPENAI_API_KEY=

# Shown in the privacy notice and Terms of use
CONTACT_EMAIL=
# Where the server is, for example "Singapore (Oracle Cloud)"
DATA_LOCATION=

# Limits (per user per 24 hours / new accounts per IP per hour)
ADVISOR_DAILY_LIMIT=30
REGISTER_MAX_PER_IP=5
